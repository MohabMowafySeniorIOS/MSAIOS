IGURATION_BUILD_DIR}/leveldb-library" "${PODS_CONFIGURATION_BUILD_DIR}/nanopb" "${PODS_ROOT}/FirebaseAnalytics/Frameworks" "${PODS_ROOT}/GoogleAdsOnDeviceConversion/Frameworks" "${PODS_ROOT}/GoogleAppMeasurement/Frameworks" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FirebaseAnalytics/Default" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GoogleAdsOnDeviceConversion" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GoogleAppMeasurement/Core" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GoogleAppMeasurement/IdentitySupport"
